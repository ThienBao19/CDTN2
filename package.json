{
  "name": "patient-tracker",
  "private": true,
  "description": "Hệ thống Theo dõi và Thông báo tình trạng bệnh nhân — CDTN2",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @pt/api prisma:migrate",
    "db:seed": "pnpm --filter @pt/api prisma:seed",
    "db:studio": "pnpm --filter @pt/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
