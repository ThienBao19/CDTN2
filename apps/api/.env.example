# Kết nối PostgreSQL (docker compose, cổng 5440)
DATABASE_URL="postgresql://pt:pt_dev_only@localhost:5440/patient_tracker?schema=public"
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Mật khẩu cho 3 tài khoản demo khi chạy seed (chỉ dùng local)
SEED_PASSWORD=
# Bí mật ký JWT, tối thiểu 32 ký tự (node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=
# Thời hạn phiên đăng nhập (giờ), dùng chung cho JWT và cookie
SESSION_HOURS=8
# true/false; để trống = bật khi NODE_ENV=production. Đặt false khi demo bằng http qua IP LAN
COOKIE_SECURE=
# Bí mật HMAC để băm mã theo dõi, tối thiểu 32 ký tự
TRACKING_CODE_SECRET=
# CSDL riêng cho e2e test (bị xóa và tạo lại mỗi lần chạy)
DATABASE_URL_TEST="postgresql://pt:pt_dev_only@localhost:5440/patient_tracker_test?schema=public"
# Firebase Cloud Messaging (tuỳ chọn): file service account JSON mã hoá base64.
# Để trống thì không gửi push, thông báo vẫn lưu và hiện trong ứng dụng.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Số tầng proxy đứng trước API (mặc định 1 = proxy /api của web). Không mở cổng API ra ngoài.
TRUST_PROXY=1
