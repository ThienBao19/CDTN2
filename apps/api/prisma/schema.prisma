// Mô hình dữ liệu — mục 10 tài liệu dự án (11 bảng).
// status_history và audit_logs chỉ thêm mới, không sửa/xóa (BR-04, mục 10.2).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FAMILY
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  LOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RoomType {
  OPERATING
  RECOVERY
  WAITING
  OTHER
}

enum LinkStatus {
  ACTIVE
  REVOKED
}

enum NotificationChannel {
  PUSH
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  // Không gửi push: chưa cấu hình FCM hoặc người nhận chưa đăng ký thiết bị
  SKIPPED
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
}

model User {
  id           String     @id @default(uuid())
  fullName     String     @map("full_name")
  email        String?    @unique
  phone        String?    @unique
  // Người nhà không có mật khẩu: vào xem bằng SĐT + họ tên + tên bệnh nhân
  passwordHash String?    @map("password_hash")
  role         Role       @default(FAMILY)
  status       UserStatus @default(ACTIVE)
  // Tăng khi đổi mật khẩu/khóa để vô hiệu mọi phiên đăng nhập cũ
  tokenVersion Int        @default(0) @map("token_version")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  statusUpdates    StatusHistory[]
  familyLinks      FamilyLink[]
  addedLinks       FamilyLink[]    @relation("LinkAddedBy")
  notifications    Notification[]
  deviceTokens     DeviceToken[]
  auditLogs        AuditLog[]
  createdSurgeries Surgery[]

  @@map("users")
}

model Patient {
  id          String   @id @default(uuid())
  patientCode String   @unique @map("patient_code")
  fullName    String   @map("full_name")
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  gender      Gender
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  surgeries Surgery[]

  @@map("patients")
}

model Room {
  id       String   @id @default(uuid())
  name     String   @unique
  type     RoomType
  location String?
  isActive Boolean  @default(true) @map("is_active")

  surgeries Surgery[]

  @@map("rooms")
}

model Surgery {
  id              String    @id @default(uuid())
  patientId       String    @map("patient_id")
  roomId          String?   @map("room_id")
  title           String
  scheduledAt     DateTime  @map("scheduled_at")
  currentStatusId Int       @map("current_status_id")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason")
  createdById     String    @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  patient       Patient          @relation(fields: [patientId], references: [id])
  room          Room?            @relation(fields: [roomId], references: [id])
  currentStatus StatusDefinition @relation(fields: [currentStatusId], references: [id])
  createdBy     User             @relation(fields: [createdById], references: [id])
  history       StatusHistory[]
  familyLinks   FamilyLink[]
  notifications Notification[]

  @@index([patientId])
  @@index([scheduledAt])
  @@map("surgeries")
}

model StatusDefinition {
  id                  Int     @id @default(autoincrement())
  // Nhóm quy trình, để mở rộng sang khám, xét nghiệm, nhập viện (mục 9.2)
  workflow            String  @default("SURGERY")
  code                String
  label               String
  description         String?
  sortOrder           Int     @map("sort_order")
  notificationMessage String  @map("notification_message")
  isActive            Boolean @default(true) @map("is_active")

  surgeries Surgery[]
  history   StatusHistory[]

  @@unique([workflow, code])
  @@unique([workflow, sortOrder])
  @@map("status_definitions")
}

model StatusHistory {
  id          String   @id @default(uuid())
  surgeryId   String   @map("surgery_id")
  statusId    Int      @map("status_id")
  changedAt   DateTime @default(now()) @map("changed_at")
  updatedById String   @map("updated_by")
  note        String?
  // Quay lui hoặc bỏ bước cần quyền và lý do (BR-01)
  isOverride  Boolean  @default(false) @map("is_override")

  surgery   Surgery          @relation(fields: [surgeryId], references: [id])
  status    StatusDefinition @relation(fields: [statusId], references: [id])
  updatedBy User             @relation(fields: [updatedById], references: [id])

  @@index([surgeryId, changedAt])
  @@map("status_history")
}

model FamilyLink {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  surgeryId   String     @map("surgery_id")
  // Họ tên người nhà do nhân viên đăng ký; người nhà phải nhập khớp để vào xem
  contactName String?    @map("contact_name")
  addedById   String?    @map("added_by")
  linkedAt    DateTime   @default(now()) @map("linked_at")
  status      LinkStatus @default(ACTIVE)
  revokedAt   DateTime?  @map("revoked_at")

  user    User    @relation(fields: [userId], references: [id])
  surgery Surgery @relation(fields: [surgeryId], references: [id])
  addedBy User?   @relation("LinkAddedBy", fields: [addedById], references: [id])

  @@unique([userId, surgeryId])
  @@index([userId])
  @@index([surgeryId, status])
  @@map("family_links")
}

model Notification {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  surgeryId String              @map("surgery_id")
  content   String
  channel   NotificationChannel @default(PUSH)
  status    DeliveryStatus      @default(PENDING)
  attempts  Int                 @default(0)
  createdAt DateTime            @default(now()) @map("created_at")
  sentAt    DateTime?           @map("sent_at")
  lastError String?             @map("last_error")
  readAt    DateTime?           @map("read_at")

  user    User    @relation(fields: [userId], references: [id])
  surgery Surgery @relation(fields: [surgeryId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  token     String         @unique
  platform  DevicePlatform
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("device_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")
  ipAddress  String?  @map("ip_address")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
