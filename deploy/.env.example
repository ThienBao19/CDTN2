# Sao chép thành deploy/.env rồi điền giá trị (không commit file .env)
POSTGRES_USER=pt
POSTGRES_PASSWORD=
POSTGRES_DB=patient_tracker
# Tối thiểu 32 ký tự
JWT_SECRET=
# Mật khẩu 3 tài khoản demo khi chạy seed
SEED_PASSWORD=
# Demo bằng http (localhost hoặc IP LAN) thì để false; chạy HTTPS thật thì true
COOKIE_SECURE=false
SESSION_HOURS=8
# Cổng truy cập hệ thống trên máy chủ
HTTP_PORT=8080
# Tuỳ chọn: thông báo đẩy Firebase
FIREBASE_SERVICE_ACCOUNT_BASE64=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
